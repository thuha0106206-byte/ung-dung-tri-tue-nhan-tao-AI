# =================================================================
# PHONECARE - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.ENV.EXAMPLE)
# Sao chép file này thành .env và điền thông tin thật của bạn
# =================================================================

# -----------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE)
# -----------------------------------------------------------------
# Chọn: 'mysql' hoặc 'sqlite'
DB_TYPE=mysql

# Thông số MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quan_ly_sua_chua

# -----------------------------------------------------------------
# 2. CẤU HÌNH AI API
# -----------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# -----------------------------------------------------------------
# 3. CẤU HÌNH SERVER
# -----------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
